# Copie para .env e preencha:  cp .env.example .env

# Porta local da VPS (escolha uma livre; confira com: sudo ss -ltnp)
HOST_PORT=8090

# Comece em simulação. Troque para false quando tudo estiver testado.
DRY_RUN=true

# Painel (usuário e senha fortes)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Robô (modo não oficial): login da conta do Instagram
IG_USERNAME=
IG_PASSWORD=
# Se a conta usa 2FA por app autenticador, cole aqui a chave secreta (opcional)
IG_TOTP_SECRET=
# Minutos entre ciclos do robô (varia ±30% sozinho)
ROBO_CICLO_MIN=30
TZ=America/Sao_Paulo

# (Opcional) Meta / Instagram Graph API oficial: só para webhooks e radar oficial
GRAPH_VERSION=v21.0
FB_PAGE_ID=
IG_USER_ID=
PAGE_ACCESS_TOKEN=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=

# Limites
MAX_AUTO_PER_HOUR=30
RADAR_INTERVAL_MIN=180

# Opcional: IA para sugerir respostas
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
